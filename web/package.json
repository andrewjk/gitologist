{
	"name": "gitologist",
	"version": "1.0.12",
	"description": "Git in TypeScript",
	"homepage": "https://github.com/andrewjk/gitologist#readme",
	"bugs": {
		"url": "https://github.com/andrewjk/gitologist/issues"
	},
	"license": "ISC",
	"author": "Andrew K",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/andrewjk/gitologist.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"dev": "vp pack --watch",
		"test": "vp test",
		"check": "vp check",
		"prepublishOnly": "vp run build",
		"package": "vp check && vp pack && tsx ./scripts/package.ts"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"bumpp": "^12.2.0",
		"tsx": "^4.23.8",
		"typescript": "^7.0.2",
		"vite-plus": "catalog:"
	},
	"packageManager": "pnpm@10.33.0"
}
